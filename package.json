{
  "name": "banking-agent-mock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:full": "node scripts/start-dev.mjs",
    "start": "node scripts/start-dev.mjs --built",
    "test:e2e:backend": "node tests/backend-integration.mjs",
    "build": "vite build",
    "test": "node --test tests/a2ui.test.js tests/planner.test.js tests/brief.test.js tests/policy.test.js tests/conversations.test.js tests/bank.test.js tests/card-loss.test.js tests/payments.test.js tests/product-insights.test.js",
    "test:ui:product": "node tests/product-ui.mjs",
    "test:chat": "node tests/chat-history.mjs",
    "test:agent": "node tests/agent-flow.mjs",
    "test:settings": "node tests/model-settings.mjs",
    "test:agent:phone": "node tests/agent-phone.mjs",
    "test:agent:inputs": "node tests/agent-inputs-live.mjs",
    "test:agent:stream": "node --test tests/agent-stream.test.js && node tests/agent-stream-ui.mjs",
    "test:card": "node tests/card-loss.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:motion": "node tests/motion-check.mjs",
    "test:flow": "node tests/flow.mjs",
    "test:mobile": "node tests/mobile-check.mjs",
    "test:docs": "node tests/arch-check.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:text": "node tests/text-audit.mjs",
    "test:copy": "node tests/copy-scan.mjs",
    "test:services": "node tests/services-flow.mjs",
    "test:savings": "node tests/savings-flow.mjs",
    "test:travel": "node tests/travel-flow.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@playwright/test": "^1.55.0"
  }
}
